# Copy to .env and replace every required placeholder before starting Compose.
# Generate a Django key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Public host/origin served by the hosting platform's HTTPS endpoint.
PUBLIC_APP_URL=https://nepse.example.com
ALLOWED_HOSTS=nepse.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://nepse.example.com
CSRF_TRUSTED_ORIGINS=https://nepse.example.com

# Supabase Session Pooler URI (port 5432). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.ayxbjwkacrgbbcywkzom:URL_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Use a URL-safe random password so it can also appear in Redis connection URLs.
REDIS_PASSWORD=

CRAWLER_USER_AGENT=NEPSEInsightBot/1.0 (+contact: your-email@example.com)
LOG_LEVEL=INFO

# Host port for local Compose; set to the platform's required port when applicable.
PORT=8080
